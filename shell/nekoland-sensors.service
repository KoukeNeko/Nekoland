# What the menu bar's readings need root for, published for every user to read: the CPU's
# power from RAPL, a second's average, and the disks' SMART. See nekoland-sensors.sh.
[Unit]
Description=Nekoland sensor readings

[Service]
ExecStart=/usr/local/libexec/nekoland-sensors
Restart=on-failure
RestartSec=5

# The only place it writes, readable by all.
RuntimeDirectory=nekoland-sensors
RuntimeDirectoryMode=0755
UMask=0022

# Root reads the RAPL counters without a capability; smartctl asks NVMe disks through admin
# commands (CAP_SYS_ADMIN) and SATA ones through SG_IO (CAP_SYS_RAWIO).
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_RAWIO
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
