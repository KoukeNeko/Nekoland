// Asks before something that loses unsaved work. The title asks; the buttons answer.

import { Theme, Button, Dialog } from "widgets.slint";

export component Confirm inherits Window {
    in property <string> question;
    in property <string> consequence;
    in property <string> action;
    // The Appearance settings' glass, as solid as the compositor's menus.
    in property <float> glass-opacity: 0.8;
    callback confirmed;
    callback cancelled;

    title: question;
    no-frame: true;
    background: transparent;
    default-font-family: Theme.font;
    default-font-size: Theme.text-body;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            reject
        }
        // The window is the card alone, on the compositor's glass and with its shadow.
        VerticalLayout {
            Dialog {
                title: question;
                body: consequence;
                background: Theme.sheet.with-alpha(root.glass-opacity);
                drop-shadow-color: transparent;
                Button {
                    text: "取消";
                    kind: "secondary";
                    clicked => { root.cancelled(); }
                }
                Button {
                    text: action;
                    kind: "danger";
                    clicked => { root.confirmed(); }
                }
            }
        }
    }
}
