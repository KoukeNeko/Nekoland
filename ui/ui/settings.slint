// Nekoland's settings. The desktop page draws the desktop small; each part of it is a way
// into its own settings. Every control here takes effect at once.

import { Theme, IconButton, Button, Switch, Segmented, Slider, TextField, Rows, Row, NavItem } from "widgets.slint";

export struct Fact {
    title: string,
    value: string,
}

// A part of the small desktop: an outline under the pointer, a solid one with its name
// when its settings are shown.
component Part {
    in property <string> name;
    in property <bool> current;
    in property <bool> name-below;
    // The wallpaper's outline goes inside it, since it fills the screen.
    in property <bool> inset;
    in property <length> radius;
    callback clicked;

    accessible-role: button;
    accessible-label: name;
    accessible-action-default => { clicked(); }

    @children

    Rectangle {
        x: inset ? 6px : -4px;
        y: self.x;
        width: parent.width - 2 * self.x;
        height: parent.height - 2 * self.y;
        border-radius: inset ? root.radius : root.radius + 4px;
        border-width: current ? 2px : touch.has-hover ? 1.5px : 0;
        border-color: current ? #ffffff : #ffffffb3;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    if current: Rectangle {
        width: label.preferred-width + 16px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        // The wallpaper's name above the windows drawn on it.
        y: name-below ? parent.height + 10px : inset ? parent.height * 0.08 : -28px;
        border-radius: 10px;
        background: Theme.ink;
        label := Text {
            text: name;
            font-size: 11px;
            font-weight: 500;
            color: Theme.on-ink;
        }
    }
}

// One way to show the applications, drawn as a sketch of it.
component StyleSketch inherits Rectangle {
    in property <int> kind;

    border-radius: 6px;
    clip: true;
    background: @linear-gradient(140deg, #8a6f72 0%, #4a3d48 55%, #23212a 100%);

    // In the overview, under the desktops.
    if kind == 0: Rectangle {
        Rectangle {
            y: 0;
            height: parent.height * 0.24;
            background: #ffffff24;
        }
        for i in 3: Rectangle {
            x: parent.width * (0.27 + i * 0.17);
            y: parent.height * 0.05;
            width: parent.width * 0.14;
            height: parent.height * 0.14;
            border-radius: 2px;
            background: #ffffff59;
        }
        Rectangle {
            x: parent.width * 0.38;
            y: parent.height * 0.31;
            width: parent.width * 0.24;
            height: parent.height * 0.07;
            border-radius: self.height / 2;
            background: #ffffff33;
        }
        for i in 18: Rectangle {
            x: parent.width * (0.2 + mod(i, 6) * 0.105);
            y: parent.height * (0.47 + floor(i / 6) * 0.16);
            width: parent.width * 0.065;
            height: self.width;
            border-radius: self.width * 0.25;
            background: #ffffffb3;
        }
    }
    // Pages of icons over the whole screen.
    if kind == 1: Rectangle {
        Rectangle {
            x: parent.width * 0.38;
            y: parent.height * 0.09;
            width: parent.width * 0.24;
            height: parent.height * 0.07;
            border-radius: self.height / 2;
            background: #ffffff33;
        }
        for i in 21: Rectangle {
            x: parent.width * (0.14 + mod(i, 7) * 0.11);
            y: parent.height * (0.26 + floor(i / 7) * 0.19);
            width: parent.width * 0.07;
            height: self.width;
            border-radius: self.width * 0.25;
            background: #ffffffb3;
        }
        for i in 2: Rectangle {
            x: parent.width * (0.48 + i * 0.04);
            y: parent.height * 0.87;
            width: 3px;
            height: 3px;
            border-radius: 1.5px;
            background: i == 0 ? #ffffff : #ffffff66;
        }
    }
    // One long page, by kind.
    if kind == 2: Rectangle {
        Rectangle {
            x: parent.width * 0.1;
            y: parent.height * 0.09;
            width: parent.width * 0.26;
            height: parent.height * 0.07;
            border-radius: self.height / 2;
            background: #ffffff33;
        }
        for row in 2: Rectangle {
            Rectangle {
                x: parent.width * 0.1;
                y: parent.height * (0.27 + row * 0.33);
                width: parent.width * 0.14;
                height: parent.height * 0.04;
                border-radius: 1px;
                background: #ffffff99;
            }
            for i in 8: Rectangle {
                x: parent.width * (0.1 + i * 0.105);
                y: parent.height * (0.36 + row * 0.33);
                width: parent.width * 0.065;
                height: self.width;
                border-radius: self.width * 0.25;
                background: #ffffffb3;
            }
        }
    }
    // The kinds down a side bar, the icons of the one chosen beside it.
    if kind == 3: Rectangle {
        Rectangle {
            x: parent.width * 0.03;
            y: parent.height * 0.06;
            width: parent.width * 0.25;
            height: parent.height * 0.88;
            border-radius: 4px;
            background: #ffffff24;
            for i in 5: Rectangle {
                x: parent.width * 0.1;
                y: parent.height * (0.1 + i * 0.12);
                width: parent.width * (i == 0 ? 0.8 : 0.55);
                height: parent.height * (i == 0 ? 0.07 : 0.035);
                border-radius: 1px;
                background: i == 0 ? #ffffff33 : i == 1 ? #ffffffd9 : #ffffff80;
            }
        }
        for i in 15: Rectangle {
            x: parent.width * (0.36 + mod(i, 5) * 0.125);
            y: parent.height * (0.2 + floor(i / 5) * 0.24);
            width: parent.width * 0.075;
            height: self.width;
            border-radius: self.width * 0.25;
            background: #ffffffb3;
        }
    }
}

component StyleChoice {
    in property <int> kind;
    in property <string> text;
    in property <bool> current;
    callback clicked;

    accessible-role: radio-button;
    accessible-checkable: true;
    accessible-checked: current;
    accessible-label: text;
    accessible-action-default => { clicked(); }

    VerticalLayout {
        spacing: 8px;
        Rectangle {
            height: self.width * 9 / 16;
            border-radius: 9px;
            border-width: current ? 2px : 0;
            border-color: Theme.ink;
            StyleSketch {
                kind: root.kind;
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
            }
        }
        Text {
            text: root.text;
            horizontal-alignment: center;
            color: current ? Theme.ink : Theme.ink-2;
            font-weight: current ? 600 : 400;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Heading inherits Text {
    font-size: 11px;
    font-weight: 500;
    color: Theme.ink-3;
}

// The page's settings, at most as wide as the desktop drawn above them.
component Column {
    property <length> margin: 28px;
    min-height: column.min-height;
    preferred-height: column.preferred-height;
    column := VerticalLayout {
        width: min(640px, parent.width - 2 * margin);
        x: (parent.width - self.width) / 2;
        spacing: 14px;
        @children
    }
}

export component Settings inherits Window {
    in-out property <bool> dark <=> Theme.dark;
    // 0 desktop, 1 appearance, 2 mouse, 3 sound, 4 startup, 5 about.
    in-out property <int> page;
    // On the desktop page: 0 applications, 1 Dock, 2 menu bar, 3 wallpaper.
    in-out property <int> part: 0;

    in-out property <int> apps-view;
    in-out property <bool> dock-glass;
    in-out property <bool> clock-24h;
    in-out property <bool> clock-weekday;
    in-out property <bool> clock-seconds;
    in property <[image]> wallpapers;
    in-out property <int> wallpaper: -1;
    in-out property <int> wallpaper-mode;
    in-out property <bool> natural-scroll;
    in-out property <bool> tap-to-click;
    in-out property <float> pointer-speed;
    in property <bool> has-sound;
    in-out property <float> volume;
    in-out property <bool> muted;
    in property <[string]> autostart;
    in property <[Fact]> facts;
    // The time the menu bar's clock is drawn with, now.
    in property <int> month;
    in property <int> day;
    in property <string> weekday;
    in property <int> hour;
    in property <int> minute;
    in property <int> second;

    callback apps-view-changed(int);
    callback setting-changed(string, bool);
    callback wallpaper-chosen(int);
    callback wallpaper-mode-changed(int);
    callback dark-changed(bool);
    callback pointer-speed-changed(float);
    callback volume-changed(float);
    callback muted-changed(bool);
    callback autostart-removed(int);
    callback autostart-added(string);
    callback dragged();
    callback minimize();
    callback maximize();
    callback close-window();

    property <[string]> pages: ["桌面", "外觀", "滑鼠與觸控板", "聲音", "啟動項目", "關於"];
    property <[string]> parts: ["應用程式", "Dock", "選單列", "桌布"];
    property <string> clock: month + "月" + day + "日 " + (clock-weekday ? "週" + weekday + " " : "")
        + (clock-24h ? (hour < 10 ? "0" : "") + hour : (hour < 12 ? "上午 " : "下午 ") + (mod(hour + 11, 12) + 1))
        + ":" + (minute < 10 ? "0" : "") + minute
        + (clock-seconds ? ":" + (second < 10 ? "0" : "") + second : "");

    title: "設定";
    no-frame: true;
    preferred-width: 980px;
    preferred-height: 720px;
    min-width: 760px;
    min-height: 520px;
    background: Theme.paper;
    default-font-family: Theme.font;
    default-font-size: Theme.text-body;

    HorizontalLayout {
        VerticalLayout {
            width: 216px;
            padding: 14px;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 2px;
            NavItem {
                text: pages[0];
                current: page == 0;
                clicked => { page = 0; }
            }
            NavItem {
                text: pages[1];
                detail: dark ? "深色" : "淺色";
                current: page == 1;
                clicked => { page = 1; }
            }
            VerticalLayout {
                padding: 10px;
                padding-top: 12px;
                padding-bottom: 4px;
                Heading { text: "輸入"; }
            }
            NavItem {
                text: pages[2];
                current: page == 2;
                clicked => { page = 2; }
            }
            VerticalLayout {
                padding: 10px;
                padding-top: 12px;
                padding-bottom: 4px;
                Heading { text: "系統"; }
            }
            NavItem {
                text: pages[3];
                detail: !has-sound ? "" : muted ? "靜音" : round(volume) + "%";
                current: page == 3;
                clicked => { page = 3; }
            }
            NavItem {
                text: pages[4];
                detail: autostart.length;
                current: page == 4;
                clicked => { page = 4; }
            }
            NavItem {
                text: pages[5];
                current: page == 5;
                clicked => { page = 5; }
            }
            Rectangle { }
        }
        Rectangle {
            width: 1px;
            background: Theme.line;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            // The window's own title bar: the page's name, and the window's buttons.
            Rectangle {
                height: 44px;
                TouchArea {
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            root.dragged();
                        }
                    }
                    double-clicked => { root.maximize(); }
                }
                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 12px;
                    spacing: 4px;
                    Text {
                        text: pages[page];
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        color: Theme.ink;
                    }
                    IconButton {
                        icon: "minimize";
                        label: "最小化";
                        size: 28px;
                        glyph: 12px;
                        y: 8px;
                        clicked => { root.minimize(); }
                    }
                    IconButton {
                        icon: "maximize";
                        label: "最大化";
                        size: 28px;
                        glyph: 12px;
                        y: 8px;
                        clicked => { root.maximize(); }
                    }
                    IconButton {
                        icon: "close";
                        label: "關閉";
                        size: 28px;
                        glyph: 12px;
                        y: 8px;
                        clicked => { root.close-window(); }
                    }
                }
            }

            flickable := Flickable {
                content-height: max(self.height, content.preferred-height);
                content := VerticalLayout {
                    width: flickable.width;
                    alignment: start;
                    padding-bottom: 24px;

                    if page == 0: VerticalLayout {
                        spacing: 6px;
                        Rectangle {
                            height: screen.height + 4px;
                            screen := Rectangle {
                                width: min(640px, parent.width - 56px);
                                height: self.width * 9 / 16;
                                x: (parent.width - self.width) / 2;
                                y: 4px;
                                border-radius: 10px;
                                drop-shadow-blur: 24px;
                                drop-shadow-offset-y: 10px;
                                drop-shadow-color: #00000059;

                                Part {
                                    width: parent.width;
                                    height: parent.height;
                                    name: parts[3];
                                    current: part == 3;
                                    inset: true;
                                    radius: 6px;
                                    clicked => { part = 3; }
                                    Rectangle {
                                        border-radius: 10px;
                                        clip: true;
                                        background: @linear-gradient(140deg, #f3b47a 0%, #d4577b 42%, #4b3f8f 78%, #1f2a5c 100%);
                                        Image {
                                            width: parent.width;
                                            height: parent.height;
                                            source: wallpapers[wallpaper];
                                            image-fit: wallpaper-mode == 0 ? cover : wallpaper-mode == 1 ? contain : preserve;
                                        }
                                    }
                                }
                                // Two windows, for the look of a desktop in use.
                                for window in 2: Rectangle {
                                    x: parent.width * (window == 0 ? 0.12 : 0.46);
                                    y: parent.height * (window == 0 ? 0.16 : 0.3);
                                    width: parent.width * (window == 0 ? 0.46 : 0.38);
                                    height: parent.height * (window == 0 ? 0.54 : 0.46);
                                    border-radius: 6px;
                                    background: window == 0 ? #fbfaf8 : #26262b;
                                    drop-shadow-blur: 16px;
                                    drop-shadow-offset-y: 6px;
                                    drop-shadow-color: #00000080;
                                    TouchArea { }
                                }
                                Part {
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height * 0.05;
                                    name: parts[2];
                                    current: part == 2;
                                    name-below: true;
                                    clicked => { part = 2; }
                                    Rectangle {
                                        border-top-left-radius: 10px;
                                        border-top-right-radius: 10px;
                                        background: #14141861;
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            Text {
                                                text: "設定";
                                                font-size: 9px;
                                                font-weight: 700;
                                                color: #ffffff;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                            Text {
                                                text: clock;
                                                font-size: 9px;
                                                font-weight: 500;
                                                color: #ffffff;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                                Part {
                                    property <length> icon: parent.height * 0.065;
                                    width: dock.preferred-width;
                                    height: dock.preferred-height;
                                    x: (parent.width - self.width) / 2;
                                    y: parent.height * 0.97 - self.height;
                                    name: parts[1];
                                    current: part == 1;
                                    radius: 10px;
                                    clicked => { part = 1; }
                                    Rectangle {
                                        border-radius: 10px;
                                        background: dock-glass ? #fafafa4d : #1c1c20f0;
                                        border-width: 0.5px;
                                        border-color: #ffffff80;
                                    }
                                    dock := HorizontalLayout {
                                        padding: icon * 0.25;
                                        spacing: icon * 0.25;
                                        Part {
                                            width: icon;
                                            height: icon;
                                            name: parts[0];
                                            current: part == 0;
                                            radius: icon * 0.26;
                                            clicked => { part = 0; }
                                            Rectangle {
                                                border-radius: icon * 0.26;
                                                background: #f1efeae6;
                                                for i in 9: Rectangle {
                                                    x: parent.width * (0.22 + mod(i, 3) * 0.22);
                                                    y: parent.height * (0.22 + floor(i / 3) * 0.22);
                                                    width: parent.width * 0.14;
                                                    height: self.width;
                                                    border-radius: self.width / 2;
                                                    background: #17171a;
                                                }
                                            }
                                        }
                                        for tint in [#f2f0ea, #2b2b31, #e9a23b, #3f8f6b, #d4577b]: Rectangle {
                                            width: icon;
                                            height: icon;
                                            border-radius: icon * 0.26;
                                            background: tint;
                                        }
                                    }
                                }
                            }
                        }
                        Column {
                            Text {
                                text: parts[part];
                                font-size: Theme.text-small;
                                color: Theme.ink-3;
                            }
                            if part == 0: Rows {
                                HorizontalLayout {
                                    padding: 16px;
                                    spacing: 12px;
                                    for name[kind] in ["概覽", "全螢幕", "分類", "側欄"]: StyleChoice {
                                        width: (parent.width - 32px - 3 * 12px) / 4;
                                        kind: kind;
                                        text: name;
                                        current: apps-view == kind;
                                        clicked => {
                                            apps-view = kind;
                                            apps-view-changed(kind);
                                        }
                                    }
                                }
                            }
                            if part == 1: Rows {
                                Row {
                                    title: "毛玻璃";
                                    first: true;
                                    Switch {
                                        label: "毛玻璃";
                                        checked <=> dock-glass;
                                        toggled(on) => { setting-changed("dock_glass", on); }
                                    }
                                }
                            }
                            if part == 2: Rows {
                                Row {
                                    title: "時制";
                                    first: true;
                                    Segmented {
                                        options: ["24 小時", "12 小時"];
                                        current: clock-24h ? 0 : 1;
                                        changed(index) => {
                                            clock-24h = index == 0;
                                            setting-changed("clock_24h", clock-24h);
                                        }
                                    }
                                }
                                Row {
                                    title: "星期";
                                    Switch {
                                        label: "星期";
                                        checked <=> clock-weekday;
                                        toggled(on) => { setting-changed("clock_weekday", on); }
                                    }
                                }
                                Row {
                                    title: "秒數";
                                    Switch {
                                        label: "秒數";
                                        checked <=> clock-seconds;
                                        toggled(on) => { setting-changed("clock_seconds", on); }
                                    }
                                }
                            }
                            if part == 3: Rows {
                                Row {
                                    title: "圖片";
                                    first: true;
                                    if wallpapers.length == 0: Text {
                                        text: "沒有圖片";
                                        color: Theme.ink-3;
                                    }
                                    for picture[index] in wallpapers: Rectangle {
                                        width: 60px;
                                        height: 38px;
                                        border-radius: 8px;
                                        border-width: wallpaper == index ? 2px : 0;
                                        border-color: Theme.ink;
                                        accessible-role: radio-button;
                                        accessible-checkable: true;
                                        accessible-checked: wallpaper == index;
                                        accessible-label: "桌布 " + (index + 1);
                                        Rectangle {
                                            x: 4px;
                                            y: 4px;
                                            width: parent.width - 8px;
                                            height: parent.height - 8px;
                                            border-radius: 5px;
                                            clip: true;
                                            Image {
                                                width: parent.width;
                                                height: parent.height;
                                                source: picture;
                                                image-fit: cover;
                                            }
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                wallpaper = index;
                                                wallpaper-chosen(index);
                                            }
                                        }
                                    }
                                }
                                Row {
                                    title: "填滿方式";
                                    Segmented {
                                        options: ["填滿", "符合", "置中"];
                                        current <=> wallpaper-mode;
                                        changed(index) => { wallpaper-mode-changed(index); }
                                    }
                                }
                            }
                        }
                    }

                    if page == 1: Column {
                        Rows {
                            Row {
                                title: "配色";
                                first: true;
                                Segmented {
                                    options: ["淺色", "深色"];
                                    current: dark ? 1 : 0;
                                    changed(index) => {
                                        dark = index == 1;
                                        dark-changed(dark);
                                    }
                                }
                            }
                        }
                    }

                    if page == 2: Column {
                        Rows {
                            Row {
                                title: "指標速度";
                                first: true;
                                Slider {
                                    width: 200px;
                                    label: "指標速度";
                                    minimum: -1;
                                    maximum: 1;
                                    step: 0.1;
                                    value <=> pointer-speed;
                                    changed(value) => { pointer-speed-changed(value); }
                                }
                            }
                            Row {
                                title: "自然捲動";
                                Switch {
                                    label: "自然捲動";
                                    checked <=> natural-scroll;
                                    toggled(on) => { setting-changed("natural_scroll", on); }
                                }
                            }
                            Row {
                                title: "輕觸以點按";
                                Switch {
                                    label: "輕觸以點按";
                                    checked <=> tap-to-click;
                                    toggled(on) => { setting-changed("tap_to_click", on); }
                                }
                            }
                        }
                    }

                    if page == 3: Column {
                        if !has-sound: Rows {
                            Row {
                                title: "沒有音訊輸出";
                                first: true;
                            }
                        }
                        if has-sound: Rows {
                            Row {
                                title: "音量";
                                first: true;
                                Slider {
                                    width: 200px;
                                    label: "音量";
                                    maximum: 100;
                                    step: 5;
                                    value <=> volume;
                                    changed(value) => { volume-changed(value); }
                                }
                                Text {
                                    width: 44px;
                                    text: round(volume) + "%";
                                    font-family: Theme.mono;
                                    font-size: 13px;
                                    color: Theme.ink-2;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                            Row {
                                title: "靜音";
                                Switch {
                                    label: "靜音";
                                    checked <=> muted;
                                    toggled(on) => { muted-changed(on); }
                                }
                            }
                        }
                    }

                    if page == 4: Column {
                        Rows {
                            for command[index] in autostart: Row {
                                title: command;
                                first: index == 0;
                                IconButton {
                                    icon: "close";
                                    label: "移除";
                                    clicked => { autostart-removed(index); }
                                }
                            }
                            Rectangle {
                                height: added.preferred-height;
                                if autostart.length > 0: Rectangle {
                                    y: 0;
                                    height: 1px;
                                    background: Theme.line;
                                }
                                added := HorizontalLayout {
                                    padding: 12px;
                                    spacing: 8px;
                                    field := TextField {
                                        placeholder: "指令";
                                        accepted(text) => {
                                            if text != "" {
                                                autostart-added(text);
                                                self.text = "";
                                            }
                                        }
                                    }
                                    Button {
                                        text: "新增";
                                        kind: "secondary";
                                        enabled: field.text != "";
                                        clicked => {
                                            autostart-added(field.text);
                                            field.text = "";
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if page == 5: Column {
                        Rows {
                            for fact[index] in facts: Row {
                                title: fact.title;
                                first: index == 0;
                                Text {
                                    text: fact.value;
                                    color: Theme.ink-2;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
